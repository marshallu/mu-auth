<?xml version="1.0"?>
<ruleset name="WordPress VIP Coding Standards">
    <description>WordPress VIP Coding Standards for HTML and PHP files in the project.</description>
    <rule ref="WordPress-VIP-Go"/>

    <!-- Paths to exclude from the scan -->
    <exclude-pattern>/acf-fields.php</exclude-pattern>
	<exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/node_modules/*</exclude-pattern>

    <!-- Paths to scan -->
    <file>.</file>
</ruleset>
