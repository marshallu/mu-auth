{
	"name": "marshallu/mu-auth",
	"type": "wordpress-plugin",
	"keywords": ["wordpress", "plugin"],
	"description": "MU Auth is a WordPress plugin that provides a simple way to authenticate users against the Marshall University SSO.",
	"license": "MIT",
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13.6",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7.1",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "php-stubs/wordpress-stubs": "^6.9",
        "php-stubs/acf-pro-stubs": "^6.2",
        "php-stubs/wp-cli-stubs": "^2.12",
		"automattic/vipwpcs": "^3.0"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "format": "phpcbf --extensions=php --standard=phpcs.xml --report-summary --report-source",
        "lint": "phpcs --extensions=php --standard=phpcs.xml",
        "analyse": "phpstan analyse --memory-limit=4G"
    }
}
