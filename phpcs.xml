<?xml version="1.0"?>
<ruleset name="MU Auth">
    <description>WordPress Coding Standards for MU Auth.</description>

    <rule ref="WordPress"/>

    <file>.</file>
    <exclude-pattern>acf-fields.php</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
    <exclude-pattern>node_modules/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
</ruleset>
